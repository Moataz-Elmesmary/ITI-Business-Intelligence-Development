  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT Course.Crs_Duration, Topic.Top_Name, Course.Crs_Name, Course.Crs_Id
FROM     Topic INNER JOIN
                  Course ON Topic.Top_Id = Course.Crs_Id
ORDER BY Topic.Top_Name</CommandText>
      </Query>
      <Fields>
        <Field Name="Crs_Duration">
          <DataField>Crs_Duration</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Top_Name">
          <DataField>Top_Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Crs_Name">
          <DataField>Crs_Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Crs_Id">
          <DataField>Crs_Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
