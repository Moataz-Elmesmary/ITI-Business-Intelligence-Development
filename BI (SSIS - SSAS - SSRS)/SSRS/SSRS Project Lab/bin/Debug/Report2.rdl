  <DataSources>
    <DataSource Name="DataSource1">
      <DataSourceReference>ITIDS</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>06b30ea7-5df0-4bd3-9b9b-97d6705e2497</rd:DataSourceID>
