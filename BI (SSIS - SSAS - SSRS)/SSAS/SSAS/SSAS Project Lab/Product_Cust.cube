      <Goal>1000</Goal>
      <Status>case
    when kpivalue("Qty KPI")&gt;1000 then 1
    when kpivalue("Qty KPI")&lt;1000 then -1
    else 0
end</Status>
      <TrendGraphic>Status Arrow - Descending</TrendGraphic>
      <StatusGraphic>Smiley Face</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>