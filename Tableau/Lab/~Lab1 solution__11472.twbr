      <aliases enabled='yes' />
      <column datatype='real' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([Sales])) - LOOKUP(ZN(SUM([Sales])), -1)'>
          <table-calc level-address='[federated.0ornmuh1dgp0gt19ypdbp0l0xncc].[yr:Ship Date:ok]' ordering-field='[federated.0ornmuh1dgp0gt19ypdbp0l0xncc].[Ship Date]' ordering-type='Field' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Sales])) - LOOKUP(ZN(SUM([Sales])), -1)) / ABS(LOOKUP(ZN(SUM([Sales])), -1))'>
          <table-calc level-address='[federated.0ornmuh1dgp0gt19ypdbp0l0xncc].[qr:Order Date:ok]' ordering-field='[federated.0ornmuh1dgp0gt19ypdbp0l0xncc].[Order Date]' ordering-type='Field' />
        </calculation>
      </column>
      <column datatype='real' name='[Calculation3]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_PERCENTILE(SUM([Profit]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='First Name' datatype='string' name='[Calculation_1143914309420883972]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT([Customer Name], FIND([Customer Name], &apos; &apos;) - 1)' />
      </column>
      <column caption='Last Name' datatype='string' name='[Calculation_1143914309421740037]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='RIGHT([Customer Name], LEN([Customer Name]) - FIND([Customer Name], &apos; &apos;))' />
      </column>
      <column caption='KPIs' datatype='string' name='[Calculation_1143914309424709639]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1143914309426110472] &gt; 0.1 THEN &quot;Good&quot;&#13;&#10;ELSEIF [Calculation_1143914309426110472] &gt;= 0 THEN &quot;Neutral&quot;&#13;&#10;ELSE &quot;Bad&quot;&#13;&#10;END' />
      </column>
      <column caption='Profit Ratio' datatype='real' name='[Calculation_1143914309426110472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
